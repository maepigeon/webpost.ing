# ─── Secrets and local configuration ──────────────────────────────────────────
# deploy.env is the ONE file that holds real credentials, and it never leaves the
# host. The application*.properties files are secret-free by design (they read
# ${VAR:default} from the environment) and ARE committed.
# See config/deploy.env.example and guide/CONFIGURATION.md.
deploy.env
*.env
!*.env.example
!client/.env.development
!client/.env.production
*.local
*.pem
*.key
*.p12
*.keystore

# ─── User data — never commit ─────────────────────────────────────────────────
uploads/
server/uploads/
*.dump
*.sql.gz
backups/
tools/backups/

