# release.env — where tools/release.sh sends a release.
#
#   cp config/release.env.example release.env && $EDITOR release.env
#
# release.env is gitignored: the repository is private, but private
# repositories get cloned and may be opened again, so the server's address,
# your username on it and its paths stay on your computer.

# ssh destination: you@your-server
DEPLOY_HOST=you@example.com

# Where the app's deploy.env is on the server.
SERVER_ENV=/path/to/deploy.env

# Upload directory on the server, inside your home.
#DEPLOY_INBOX=incoming
