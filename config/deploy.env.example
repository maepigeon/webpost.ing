# ══════════════════════════════════════════════════════════════════════════════
#  webpost.ing — deployment configuration
#
#  Copy this file to `deploy.env` in the repo root, fill in the real values, and
#  keep it on the server only. `deploy.env` is gitignored; this template is not.
#
#      cp config/deploy.env.example deploy.env
#      chmod 600 deploy.env          # it holds the database password
#      $EDITOR deploy.env
#
#  server-start.sh and deploy.sh source it automatically. Nothing else in the
#  repo contains environment-specific values — every application*.properties
#  entry reads from the variables below with a local-development default, so
#  this is the one file to edit per environment.
#
#  Full reference, including which code reads each variable:
#  guide/CONFIGURATION.md
# ══════════════════════════════════════════════════════════════════════════════

# ── Profile ───────────────────────────────────────────────────────────────────
# dev  — local development: cookies work over plain HTTP, uploads under server/
# prod — production: HTTPS-only cookies, absolute upload path, no stack traces
APP_PROFILE=prod

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webpostingdb
DB_USER=mae
# The only secret in this file. Never commit it, never paste it into a chat.
DB_PASSWORD=change-me

# Optional pool tuning.
#DB_POOL_SIZE=10
#DB_CONNECTION_TIMEOUT=20000

# ── Origins ───────────────────────────────────────────────────────────────────
# Every origin the frontend is served from, comma-separated. Must be exact
# (scheme + host + port) — "*" is rejected, because the API uses credentialed
# requests and a wildcard there would let any site read a logged-in user's data.
ALLOWED_ORIGINS=https://webpost.ing

# ── File storage ──────────────────────────────────────────────────────────────
# Absolute path in production. Must exist and be writable by the server user.
UPLOAD_DIR=/var/www/webposting/uploads

# Per-file upload ceiling. Keep the two in agreement: the first is parsed by
# Spring's multipart resolver, the second is the byte count the app enforces.
#UPLOAD_MAX_SIZE=50MB
#UPLOAD_MAX_BYTES=52428800

# ── Sessions ──────────────────────────────────────────────────────────────────
# Absolute lifetime, and idle timeout reset by each authorized request.
# Sessions are held in memory, so a restart ends all of them regardless.
#SESSION_LIFETIME_MINUTES=1440
#SESSION_IDLE_MINUTES=720

# ── Email (optional) ──────────────────────────────────────────────────────────
# The entire email feature — verification, notifications, password reset — is
# off unless MAIL_ENABLED=true. Leave it false and the app behaves exactly as it
# did before: nothing is sent and no SMTP connection is attempted.
#MAIL_ENABLED=true
#MAIL_FROM=no-reply@webpost.ing
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#MAIL_USERNAME=apikey
# A second secret, if you enable this. Same rules as DB_PASSWORD.
#MAIL_PASSWORD=change-me
#MAIL_SMTP_AUTH=true
#MAIL_SMTP_STARTTLS=true

# Public URL of the site. Used to build links inside emails, so it must be the
# address a recipient can actually open — not localhost.
APP_BASE_URL=https://webpost.ing

# ── Logging ───────────────────────────────────────────────────────────────────
#LOG_LEVEL=INFO

# ── Deployment paths (read by deploy.sh, not by the application) ──────────────
# Where nginx serves the built frontend from.
WEB_ROOT=/var/www/webpost.ing/html
# Where the systemd unit expects to find the JAR.
APP_HOME=/home/webpost.ing
# The systemd unit to restart after publishing new artifacts.
SERVICE_NAME=start-servers.service
